# Ejemplo publicable: no contiene credenciales ni datos institucionales.
# Variables propuestas; el codigo actual NO carga .env ni utiliza estos valores.
# No agregar usuarios, contrasenas, cookies ni tokens de SIGAC.
# Copiar a .env solo cuando exista una configuracion que lo consuma.
TINOTIFY_ENV=development
TINOTIFY_DATA_MODE=synthetic
TINOTIFY_DATABASE_URL=sqlite:///./datos_privados/tinotify_demo.sqlite3
TINOTIFY_PUSH_ENABLED=false

# Nunca colocar secretos en variables EXPO_PUBLIC_*: se incluyen en la app.
