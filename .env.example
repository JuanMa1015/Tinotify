# Ejemplo publicable. El backend actual NO carga ni consume estas variables.
# No configuran todavia barreras de red, autorizacion ni un modo sintetico.
TINOTIFY_ENV=development
TINOTIFY_DATA_MODE=synthetic
TINOTIFY_PUSH_ENABLED=false

# Identificadores publicos del proyecto remoto de desarrollo existente.
SUPABASE_PROJECT_REF=urxfnmyuwbvnvrxkkppw
# DSN reservado para herramientas futuras: es secreto, no es un identificador publico.
# Configurarlo solo fuera del ejemplo; actualmente no lo consume el backend.
DATABASE_URL=
SUPABASE_URL=https://urxfnmyuwbvnvrxkkppw.supabase.co
TINOTIFY_AUTH_ISSUER=https://urxfnmyuwbvnvrxkkppw.supabase.co/auth/v1
TINOTIFY_AUTH_JWKS_URL=https://urxfnmyuwbvnvrxkkppw.supabase.co/auth/v1/.well-known/jwks.json
TINOTIFY_AUTH_AUDIENCE=authenticated

# Futuros procesos de servidor: DSN diferentes, con TLS y roles restringidos.
# Configurar valores reales solo en un gestor local o en secretos de Render.
# No usar postgres, service_role ni credenciales administrativas en estos DSN.
TINOTIFY_API_DATABASE_URL=
TINOTIFY_SYNC_DATABASE_URL=
TINOTIFY_NOTIFICATIONS_DATABASE_URL=
# Configuracion futura de composicion: CA publica revisada y modalidad explicita.
# No se cargan automaticamente ni activan persistencia desde /health.
TINOTIFY_DB_SSLROOTCERT=
TINOTIFY_DB_CONNECTION_MODE=directa
TINOTIFY_DB_POOL_MAX=4

# Solo una futura app movil. La clave publishable no es una clave privilegiada.
# Se deja vacia; no copiar service_role ni sb_secret_* aqui.
EXPO_PUBLIC_SUPABASE_URL=https://urxfnmyuwbvnvrxkkppw.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=

# Telemetria opcional de CLI. Exportar tambien en PowerShell antes de usarla;
# no asumir que la CLI lee este archivo de ejemplo o el .env raiz.
SUPABASE_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# SUPABASE_ACCESS_TOKEN y SUPABASE_DB_PASSWORD se configuran fuera del repo,
# mediante login interactivo/almacen seguro; no se incluyen en este ejemplo.
# No agregar contrasenas, cookies, sesiones ni tokens de SIGAC.
# EXPO_PUBLIC_* se incluye en la app: nunca contiene secretos.
